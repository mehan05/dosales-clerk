---
import Layout from '../../layouts/Layout.astro';
import { OrganizationList } from '@clerk/astro/components';
---

<Layout title="Your Organizations | DoSales">
  <div class="list-container">
    <h1 class="page-title">Manage Your Organizations</h1>
    <p class="page-description">Switch between your existing organizations or create a new one.</p>
    
    <div class="clerk-list-wrapper">
      <OrganizationList 
        hidePersonal={false}
        afterCreateOrganizationUrl="/organization-profile"
        afterSelectOrganizationUrl="/"
      />
    </div>
  </div>
</Layout>

<style>
  .list-container {
    padding: 2rem 0;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: #030712;
    text-align: center;
  }

  .page-description {
    color: #4A5565;
    text-align: center;
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }

  .clerk-list-wrapper {
    display: flex;
    justify-content: center;
  }
</style>
