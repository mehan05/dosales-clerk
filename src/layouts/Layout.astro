<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #030712;
    background-color: #f9fafb;
	}

  main {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Outfit', sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>
